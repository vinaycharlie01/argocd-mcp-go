{
  // Open this folder in VS Code, then start "devops" from "MCP: List Servers".
  // VS Code prompts for the values below; the token is stored as a secret.
  "inputs": [
    {
      "type": "promptString",
      "id": "argocd-server",
      "description": "Argo CD server host, e.g. argocd.example.com"
    },
    {
      "type": "promptString",
      "id": "argocd-token",
      "description": "Argo CD token (value of the argocd.token cookie)",
      "password": true
    }
  ],
  "servers": {
    "devops": {
      "type": "stdio",
      "command": "go",
      "args": ["run", "${workspaceFolder}/cmd/server"],
      "env": {
        "ARGOCD_SERVER": "${input:argocd-server}",
        "ARGOCD_AUTH_TOKEN": "${input:argocd-token}",
        "LOG_LEVEL": "debug",
        "LOG_FORMAT": "text"
      }
    }
  }
}
