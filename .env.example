# Required: the Argo CD URL. Issuer/client ID/scopes are discovered from /api/v1/settings.
ARGOCD_SERVER_URL=https://argocd-lowerenv.qwikcilver.com

# Optional overrides (only if discovery is not what you want)
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<entra-app-client-id>
# OIDC_SCOPES=openid,profile,email
# OIDC_REDIRECT_URL=http://localhost:8085/auth/callback
# OIDC_DOMAIN_HINT=qwikcilver.com
# ARGOCD_CA_FILE=/path/to/ca.pem
# ARGOCD_INSECURE_SKIP_VERIFY=false

# Transport: stdio (local, default) or http (Streamable HTTP)
# MCP_TRANSPORT=http
# MCP_HTTP_ADDR=:8080
# MCP_PUBLIC_URL=https://argocd-mcp.example.com

LOG_LEVEL=info
LOG_FORMAT=json
