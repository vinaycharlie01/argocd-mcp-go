# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Argo CD ---
# Host (as for `argocd --server`) or full https URL.
ARGOCD_SERVER=argocd.example.com
# Your own Argo CD token: the value of the argocd.token cookie after browser SSO.
ARGOCD_AUTH_TOKEN=
# Alternative: a file holding the token, re-read on every request (rotate without restart).
# ARGOCD_AUTH_TOKEN_FILE=/path/to/argocd-token
# ARGOCD_CA_FILE=
# ARGOCD_INSECURE=false
# ARGOCD_REQUEST_TIMEOUT=30s

# --- Deploy server only (cmd/deploy, write-enabled) ---
# Limit writes to these Argo CD projects (comma separated). Empty = any project your token can write to.
# ARGOCD_DEPLOY_ALLOWED_PROJECTS=team-a,team-b
# Helm parameter names that hold the image (defaults below).
# ARGOCD_HELM_TAG_PARAM=image.tag
# ARGOCD_HELM_REPOSITORY_PARAM=image.repository
# How long argocd_sync_application waits for the sync and health (max 15m).
# ARGOCD_SYNC_TIMEOUT=5m

# --- Logging (stderr) ---
LOG_LEVEL=info
LOG_FORMAT=json
