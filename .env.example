# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Argo CD ---
# Host (as for `argocd --server`) or full https URL.
ARGOCD_SERVER=argocd.example.com
# Your own Argo CD token: the value of the argocd.token cookie after browser SSO.
ARGOCD_AUTH_TOKEN=
# Alternative: a file holding the token, re-read on every request (rotate without restart).
# ARGOCD_AUTH_TOKEN_FILE=/path/to/argocd-token
# ARGOCD_CA_FILE=
# ARGOCD_INSECURE=false
# ARGOCD_REQUEST_TIMEOUT=30s

# --- Logging (stderr) ---
LOG_LEVEL=info
LOG_FORMAT=json
